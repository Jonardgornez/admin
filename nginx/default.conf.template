# ${ADMIN_PORT} and ${SERVER_PORT} are filled in from the environment when the container starts.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # Loopback only: the console can be opened on this computer and nowhere else.
    listen 127.0.0.1:${ADMIN_PORT};
    server_name localhost;

    root /usr/share/nginx/html;

    # Client installer uploads can be up to 150 MB; the server checks the exact limit itself.
    client_max_body_size 151m;

    location /api/ {
        proxy_pass http://127.0.0.1:${SERVER_PORT};
        proxy_http_version 1.1;
        # The server only accepts the admin port with a localhost Host header.
        proxy_set_header Host localhost;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Large uploads go straight through instead of being saved to a temp file first.
        proxy_request_buffering off;
        # Live view and remote control keep a WebSocket open for as long as the admin watches.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
